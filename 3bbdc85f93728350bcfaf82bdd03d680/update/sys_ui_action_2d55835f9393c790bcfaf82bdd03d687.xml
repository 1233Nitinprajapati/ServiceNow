        <name>Check In Visitor</name>
        <onclick>checkInVisit()</onclick>
        <order>100</order>
        <script><![CDATA[function checkInVisit() {
    if (!confirm('Are you sure you want to check in this visitor?')) {
        return;
    }

    // Use GlideAjax to get the server time
    var ga = new GlideAjax('DateTimeUtils');
    ga.addParam('sysparm_name', 'getCurrentDateTime');
    ga.getXMLAnswer(function(answer) {
        // 'answer' contains the server's current date/time
        g_form.setValue('u_status', 'checked_in');
        g_form.setValue('u_check_in', answer);
        g_form.save();
        g_form.addInfoMessage('Visitor checked in successfully. Parking slot marked as Occupied.');
    });
}]]></script>
