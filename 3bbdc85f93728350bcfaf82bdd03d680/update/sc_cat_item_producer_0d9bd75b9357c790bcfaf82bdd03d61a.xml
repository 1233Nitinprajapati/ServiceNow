        <script><![CDATA[(function() {
    
    // ---------- STEP 1: FIND OR CREATE THE VISITOR ----------
    var visitorSysId = '';
    var visitorEmail = producer.getValue('visitor_email');
    
    var visitorGr = new GlideRecord('x_2137028_validp_0_visitor');
    visitorGr.addQuery('u_email', visitorEmail);
    visitorGr.setLimit(1);
    visitorGr.query();

    if (visitorGr.next()) {
        visitorSysId = visitorGr.getUniqueValue();
    } else {
        var newVisitor = new GlideRecord('x_2137028_validp_0_visitor');
        newVisitor.initialize();
        
        var fullName  = String(producer.visitor_name || '');
        

        newVisitor.u_visitor_name = fullName;
        newVisitor.u_email      = visitorEmail;
        newVisitor.u_company    = producer.visitor_company || '';
		newVisitor.setValue('u_status','registered');
		newVisitor.u_id_proof = producer.id_proof || " ";
		newVisitor.u_purpose  = producer.purpose || ' ';
		newVisitor.u_phone = producer.phone || ' ';
		    visitorSysId = newVisitor.insert();
    }

    // ---------- STEP 2: CREATE THE VEHICLE ----------
    var vehicleSysId = '';
    if (producer.vehicle_plate) {
        var vehicleGr = new GlideRecord('x_2137028_validp_0_vehicle');
        vehicleGr.initialize();
        vehicleGr.u_vehicle_number = producer.vehicle_plate;
        vehicleGr.u_visitor       = visitorSysId;
		vehicleGr.u_vehicle_type = producer.vehicle_type || ' ';
        vehicleSysId = vehicleGr.insert();
    }

    // ---------- STEP 3: FIND AN AVAILABLE PARKING SLOT ----------
    var slotSysId = '';
    var slotLabel = 'No slot available';
    
    var slotGr = new GlideRecord('x_2137028_validp_0_parking_slot');
    slotGr.addQuery('u_status', 'available');
    slotGr.addQuery('u_slot_type', producer.slot_type);
    slotGr.orderBy('u_slot_number');
    slotGr.setLimit(1);
    slotGr.query();

    if (slotGr.next()) {
		slotGr.setValue('u_status','reserved');
		slotGr.update();
        slotSysId = slotGr.getUniqueValue();
        slotLabel = slotGr.u_slot_number.toString();
    }

    // ---------- STEP 4: MAP VALUES TO CURRENT VISIT RECORD ----------
    current.u_visitor = visitorSysId;
    current.u_vehicle = vehicleSysId;
    
    if (slotSysId) {
        current.u_parking_slot = slotSysId;

    }

    current.u_status = 'scheduled';

    // Corrected to match the actual variable name: arrival_date
    if (producer.arrival_date) {
        current.u_check_in = producer.arrival_date;
    }

    // ---------- STEP 5: USER FEEDBACK ----------
    if (slotSysId) {
        gs.addInfoMessage('Parking request submitted. Slot ' + slotLabel + ' reserved for your visitor.');
    } else {
        gs.addInfoMessage('Parking request submitted, but no ' + producer.slot_type + ' slot is currently available.');
    }

})();]]></script>
